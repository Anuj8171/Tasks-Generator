generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Spec {
  id          String   @id @default(uuid())
  goal        String
  users       String
  constraints String
  stories     String
  tasks       String
  createdAt   DateTime @default(now())
}
